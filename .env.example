# Copy to .env and adjust. Both docker compose and the backend read this file.

# --- Postgres (docker compose) ---
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat
POSTGRES_DB=chat
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat
TEST_DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat_test
OLLAMA_BASE_URL=http://localhost:11434
# Model used when a chat has none selected. Leave empty to use the first installed chat model.
DEFAULT_MODEL=
# Optional system prompt sent at the start of every conversation.
SYSTEM_PROMPT=
# Seconds to wait between tokens before giving up on Ollama.
OLLAMA_TIMEOUT=300
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=["http://localhost:5173"]
